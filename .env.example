# Copy to your shell or a local untracked .env; the application does not auto-read .env.
OMO_API_KEY=replace-with-random-key-at-least-24-characters
OMO_SANDBOX_ENABLED=true
OMO_EXTERNAL_ENABLED=false
# Optional: enables authorized configured providers only when true and request budget > 0.
# OMO_PROVIDER_KEY_OPENROUTER=replace-with-provider-key
