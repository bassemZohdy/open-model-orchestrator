{
  "$defs": {
    "Arithmetic": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "decimal",
          "default": "decimal",
          "title": "Id",
          "type": "string"
        },
        "operation": {
          "enum": [
            "add",
            "subtract",
            "multiply",
            "divide"
          ],
          "title": "Operation",
          "type": "string"
        },
        "a": {
          "pattern": "^-?\\d{1,12}(\\.\\d{1,8})?$",
          "title": "A",
          "type": "string"
        },
        "b": {
          "pattern": "^-?\\d{1,12}(\\.\\d{1,8})?$",
          "title": "B",
          "type": "string"
        },
        "unit": {
          "default": "",
          "enum": [
            "",
            "AED",
            "USD",
            "kg",
            "m",
            "s"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "operation",
        "a",
        "b"
      ],
      "title": "Arithmetic",
      "type": "object"
    },
    "EvenSquares": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "even_squares",
          "default": "even_squares",
          "title": "Id",
          "type": "string"
        },
        "values": {
          "items": {
            "maximum": 10000,
            "minimum": -10000,
            "type": "integer"
          },
          "maxItems": 128,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "values"
      ],
      "title": "EvenSquares",
      "type": "object"
    },
    "Message": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "system",
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        },
        "content": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "Message",
      "type": "object"
    },
    "Options": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "local_only": {
          "default": false,
          "title": "Local Only",
          "type": "boolean"
        },
        "action": {
          "default": "auto",
          "enum": [
            "auto",
            "local_answer",
            "helper",
            "external_model"
          ],
          "title": "Action",
          "type": "string"
        },
        "helper": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "decimal": "#/$defs/Arithmetic",
                  "even_squares": "#/$defs/EvenSquares"
                },
                "propertyName": "id"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/Arithmetic"
                },
                {
                  "$ref": "#/$defs/EvenSquares"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Helper"
        },
        "required_capability": {
          "default": "text",
          "enum": [
            "text",
            "coding",
            "current_information"
          ],
          "title": "Required Capability",
          "type": "string"
        },
        "max_cost_usd": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Max Cost Usd",
          "type": "number"
        }
      },
      "title": "Options",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "model": {
      "const": "omo",
      "default": "omo",
      "title": "Model",
      "type": "string"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/Message"
      },
      "maxItems": 24,
      "minItems": 1,
      "title": "Messages",
      "type": "array"
    },
    "stream": {
      "default": false,
      "title": "Stream",
      "type": "boolean"
    },
    "max_tokens": {
      "default": 96,
      "maximum": 256,
      "minimum": 8,
      "title": "Max Tokens",
      "type": "integer"
    },
    "omo": {
      "$ref": "#/$defs/Options"
    }
  },
  "required": [
    "messages"
  ],
  "title": "ChatRequest",
  "type": "object"
}
