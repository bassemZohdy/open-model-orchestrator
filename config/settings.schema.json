{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "host": {
      "default": "127.0.0.1",
      "title": "Host",
      "type": "string"
    },
    "port": {
      "default": 8000,
      "maximum": 65535,
      "minimum": 1024,
      "title": "Port",
      "type": "integer"
    },
    "api_key": {
      "anyOf": [
        {
          "format": "password",
          "type": "string",
          "writeOnly": true
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Api Key"
    },
    "model_path": {
      "default": "models/embedded.gguf",
      "title": "Model Path",
      "type": "string"
    },
    "model_manifest": {
      "default": "models/manifest.json",
      "title": "Model Manifest",
      "type": "string"
    },
    "registry_path": {
      "default": "config/registry.yaml",
      "title": "Registry Path",
      "type": "string"
    },
    "threads": {
      "default": 4,
      "maximum": 8,
      "minimum": 1,
      "title": "Threads",
      "type": "integer"
    },
    "context_tokens": {
      "default": 2048,
      "maximum": 4096,
      "minimum": 1024,
      "title": "Context Tokens",
      "type": "integer"
    },
    "analysis_tokens": {
      "default": 768,
      "maximum": 1024,
      "minimum": 128,
      "title": "Analysis Tokens",
      "type": "integer"
    },
    "inference_queue": {
      "default": 4,
      "maximum": 16,
      "minimum": 1,
      "title": "Inference Queue",
      "type": "integer"
    },
    "max_inflight": {
      "default": 8,
      "maximum": 32,
      "minimum": 1,
      "title": "Max Inflight",
      "type": "integer"
    },
    "requests_per_minute": {
      "default": 120,
      "maximum": 600,
      "minimum": 1,
      "title": "Requests Per Minute",
      "type": "integer"
    },
    "deadline_seconds": {
      "default": 20.0,
      "maximum": 60.0,
      "minimum": 1.0,
      "title": "Deadline Seconds",
      "type": "number"
    },
    "sandbox_enabled": {
      "default": false,
      "title": "Sandbox Enabled",
      "type": "boolean"
    },
    "external_enabled": {
      "default": false,
      "title": "External Enabled",
      "type": "boolean"
    },
    "external_max_cost_usd": {
      "default": 0.01,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "External Max Cost Usd",
      "type": "number"
    }
  },
  "title": "Settings",
  "type": "object"
}
